# Copy to .env.local and fill in. Never commit .env.local.
# Local values come from `npx supabase status`; hosted values from the Supabase dashboard
# (Project Settings > API Keys).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-secret-key

# Public address of the site, used in email links (e.g. https://sponsors.rwcll.org).
SITE_URL=http://localhost:3000

# Optional email (see README "Email"). Either SMTP, e.g. Gmail with an app password:
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# ...or Resend (https://resend.com):
RESEND_API_KEY=
# Sender; for Gmail it must be the SMTP_USER account or one of its aliases.
EMAIL_FROM="RWCLL Sponsorships <sponsors@rwcll.org>"

# Optional: any long random string. Vercel sends it with the daily keep-alive job so
# nobody else can call /api/keep-alive.
CRON_SECRET=
